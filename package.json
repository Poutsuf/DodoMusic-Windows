{
  "name": "dodomusic",
  "version": "1.5.0",
  "description": "DodoMusic — свободный и стильный музыкальный плеер нового поколения для Windows",
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron electron-main.cjs",
    "server": "node server.js",
    "dev": "node --watch server.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Poutsuf/DodoMusic-Windows.git"
  },
  "keywords": [
    "music",
    "player",
    "streaming",
    "electron",
    "desktop",
    "smart-wave",
    "live-wallpapers",
    "audio-visualizer",
    "windows"
  ],
  "author": "DodoMusic Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.29.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.dodomusic.app",
    "productName": "DodoMusic",
    "electronVersion": "33.4.11",
    "copyright": "Copyright © 2026 DodoMusic Team",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "electron-main.cjs",
      "server.js",
      "package.json",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DodoMusic",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "uninstallDisplayName": "DodoMusic",
      "deleteAppDataOnUninstall": false
    }
  }
}
